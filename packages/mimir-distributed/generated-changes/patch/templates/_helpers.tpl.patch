 {{/*
+Patched labels for resource metadata (non-pod resources)
+Params:
+  ctx = . context
+These labels are required by kyverno-cluster-policies/require-resource-labels
+*/}}
+{{- define "mimir.patchedLabels" -}}
+{{- with .ctx.Values.patchedLabels }}
+{{ toYaml . }}
+{{- end }}
+{{- end -}}
+
+{{/*
+Merged resource annotations: the patched (compliance) annotations plus a component's own
+annotations, rendered as a single map. Required by kyverno-cluster-policies/
+require-resource-annotations. Merging into one map before a single toYaml call (rather than
+concatenating two separate toYaml blocks) avoids invalid YAML when "extra" is the chart's
+"{}" default -- a bare "{}" appended as a sibling of a real key is not valid YAML.
+Params:
+  ctx = . context
+  extra = component-specific annotations map (optional)
+*/}}
+{{- define "mimir.patchedAnnotations" -}}
+{{- $merged := merge (deepCopy (.extra | default dict)) (.ctx.Values.patchedAnnotations | default dict) -}}
+{{- if $merged }}
+{{ toYaml $merged -}}
+{{- else }}
+{}
+{{- end }}
+{{- end -}}
