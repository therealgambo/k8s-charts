--- charts-original/templates/rbac.yaml
+++ charts/templates/rbac.yaml
@@ -1 +1,66 @@
-{{ include "libcoder.namespace.rbac.tpl" . }}
+---
+apiVersion: rbac.authorization.k8s.io/v1
