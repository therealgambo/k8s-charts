+  labels:
+    app.kubernetes.io/name: coder
+    {{- include "coder.patchedLabels" . | nindent 4 }}
+  annotations:
+    {{- include "coder.patchedAnnotations" . | nindent 4 }}
+rules:
+  - apiGroups: [""]
