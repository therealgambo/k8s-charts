@@ -1,4 +1,21 @@
 {{/*
+Patched labels to satisfy kyverno-cluster-policies requirements. Deliberately does NOT set
+app.kubernetes.io/managed-by -- coder.labels (upstream) already sets that via .Release.Service
+everywhere this is included alongside it; templates that don't call coder.labels (rbac.yaml) set
+managed-by explicitly themselves instead.
+*/}}
+{{- define "coder.patchedLabels" -}}
+metadata.example.com/team: platform
+{{- end }}
+
+{{/*
+Patched annotations to satisfy kyverno-cluster-policies requirements
+*/}}
+{{- define "coder.patchedAnnotations" -}}
+metadata.example.com/repository: https://github.com/therealgambo/k8s-charts
+{{- end }}
+
+{{/*
 Service account to merge into the libcoder template
 */}}
 {{- define "coder.serviceaccount" -}}
