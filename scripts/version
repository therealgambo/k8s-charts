#!/usr/bin/env bash
# Pinned releases of tools used to build and validate charts in this repo.
# Bump the relevant *_VERSION to pick up a newer build of that tool.
#
# CI (.github/workflows/validate-charts.yaml) sources this file too, so
# HELM_VERSION stays the single source of truth for the version installed
# both here and there.

# https://github.com/rancher/charts-build-scripts
CHARTS_BUILD_SCRIPTS_REPO="https://github.com/rancher/charts-build-scripts"
CHARTS_BUILD_SCRIPT_VERSION="${CHARTS_BUILD_SCRIPT_VERSION:-v1.9.27}"

# https://github.com/yannh/kubeconform
KUBECONFORM_REPO="https://github.com/yannh/kubeconform"
KUBECONFORM_VERSION="${KUBECONFORM_VERSION:-v0.8.0}"

# https://github.com/helm/helm
HELM_VERSION="${HELM_VERSION:-v4.2.3}"

# https://github.com/homeport/dyff
DYFF_REPO="https://github.com/homeport/dyff"
DYFF_VERSION="${DYFF_VERSION:-v1.12.0}"
